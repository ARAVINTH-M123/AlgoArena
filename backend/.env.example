# Prisma direct PostgreSQL URL. Do not use prisma+postgres://.
DB_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
SPRING_PROFILES_ACTIVE=prod

# --- Initial admin bootstrap (first startup only, never overwrites an existing admin) ---
# Set to true only for the first deployment when creating the initial admin.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=youradmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-8-chars

# Required when SPRING_PROFILES_ACTIVE=prod. Generate a random value of at least 32 bytes.
APP_JWT_SECRET=replace-with-a-random-secret
